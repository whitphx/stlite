{
  "name": "@stlite/cloudflare",
  "version": "0.1.0",
  "description": "Deploy stlite-backed Streamlit apps to Cloudflare Python Workers.",
  "keywords": [
    "cloudflare",
    "pyodide",
    "stlite",
    "streamlit",
    "wasm",
    "webassembly"
  ],
  "bugs": {
    "url": "https://github.com/whitphx/stlite/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Yuichiro Tachibana (Tsuchiya)",
    "url": "https://www.whitphx.info/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whitphx/stlite.git",
    "directory": "packages/cloudflare"
  },
  "bin": {
    "stlite-cloudflare": "./bin/stlite-cloudflare.mjs"
  },
  "files": [
    "bin",
    "frontend",
    "scripts",
    "py/**/*.py",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "fix:lint": "oxlint --fix bin frontend scripts",
    "fix:format": "oxfmt .",
    "check:lint": "oxlint bin frontend scripts",
    "check:format": "oxfmt --check .",
    "test": "uv run --project . pytest",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "playwright": "^1.61.1",
    "wrangler": "^4.105.0"
  }
}
