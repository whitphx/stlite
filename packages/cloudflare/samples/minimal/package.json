{
  "name": "stlite-cloudflare-sample-minimal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "stlite-cloudflare build ./app -o ./dist --slim --bundled-runtime --name stlite-cloudflare-minimal",
    "dev": "yarn build && wrangler dev -c dist/wrangler.jsonc",
    "deploy": "yarn build && wrangler deploy -c dist/wrangler.jsonc",
    "start": "yarn dev"
  },
  "devDependencies": {
    "@stlite/cloudflare": "workspace:^",
    "wrangler": "^4.105.0"
  }
}
