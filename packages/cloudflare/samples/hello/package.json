{
  "name": "stlite-cloudflare-sample-hello",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "stlite-cloudflare build ./app -o ./dist --name stlite-cloudflare",
    "dev": "yarn build && wrangler dev -c dist/wrangler.jsonc",
    "deploy": "yarn build && wrangler deploy -c dist/wrangler.jsonc",
    "start": "yarn dev",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@stlite/cloudflare": "workspace:^",
    "playwright": "^1.61.1",
    "wrangler": "^4.105.0"
  }
}
